{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/education", "destination": "/experiences", "permanent": true },
    { "source": "/shop", "destination": "/support", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/hub",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/enquire/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/auth/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/education",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/shop",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/horses", "destination": "/horses/index.html" },
    { "source": "/horses/rip", "destination": "/horses/rip/index.html" },
    { "source": "/horses/haven", "destination": "/horses/haven/index.html" },
    { "source": "/horses/pedro", "destination": "/horses/pedro/index.html" },
    { "source": "/horses/diablo", "destination": "/horses/diablo/index.html" },
    { "source": "/horses/khan", "destination": "/horses/khan/index.html" },
    { "source": "/horses/kohan", "destination": "/horses/kohan/index.html" },
    { "source": "/horses/joey", "destination": "/horses/joey/index.html" },
    { "source": "/horses/ritz", "destination": "/horses/ritz/index.html" },
    { "source": "/horses/electra", "destination": "/horses/electra/index.html" },
    { "source": "/horses/kahu", "destination": "/horses/kahu/index.html" },
    { "source": "/adoption", "destination": "/adoption/index.html" },
    { "source": "/sponsorship", "destination": "/sponsorship/index.html" },
    { "source": "/foster", "destination": "/foster/index.html" },
    { "source": "/volunteer", "destination": "/volunteer/index.html" },
    { "source": "/experiences", "destination": "/experiences/index.html" },
    { "source": "/support", "destination": "/support/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
